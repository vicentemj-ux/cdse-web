---
// Trust Signals Component - Astro (zero-JS)

const brands = [
  { name: 'Apple', src: '/apple.jpg' },
  { name: 'Samsung', src: '/samsung.jpg' },
  { name: 'HP', src: '/hp.jpg' },
  { name: 'Nintendo', src: '/nintendo.jpg' },
  { name: 'Microsoft', src: '/microsoft.jpg' },
];
---

<section id="nosotros" class="bg-white px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-16 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-[#1d1d1f] md:text-4xl">
        Marcas de Confianza
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-[#86868b]">
        Especialistas en reparacion de las marcas mas reconocidas del mundo.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
      {brands.map((brand) => (
        <div class="group flex items-center justify-center transition-all duration-500">
          <img
            src={brand.src}
            alt={brand.name}
            class="h-12 w-auto object-contain opacity-60 grayscale transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0 group-hover:opacity-100 md:h-16"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<section class="w-full bg-slate-50 px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="rounded-lg bg-gradient-to-r from-blue-600 to-teal-600 p-12 text-center text-white">
      <div class="mb-4 text-6xl font-bold">16 Anos</div>
      <h3 class="mb-2 text-3xl font-bold">de Excelencia</h3>
      <p class="text-xl opacity-90">
        Sirviendo a la comunidad de Los Mochis con servicios de reparacion confiables y profesionales
      </p>
    </div>
  </div>
</section>

<section class="w-full bg-slate-50 px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-4xl font-bold text-slate-900">Testimonios de Clientes</h2>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div class="rounded-lg border-l-4 border-blue-600 bg-white p-8 shadow-md">
        <div class="mb-4 flex gap-1">
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
        </div>
        <p class="mb-4 text-slate-700">
          "Excelente servicio. Me repararon la pantalla del celular en solo 2 horas. Muy profesionales y precios justos."
        </p>
        <p class="font-semibold text-slate-900">Maria Gonzalez</p>
      </div>

      <div class="rounded-lg border-l-4 border-teal-600 bg-white p-8 shadow-md">
        <div class="mb-4 flex gap-1">
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
        </div>
        <p class="mb-4 text-slate-700">
          "Lleve mi laptop con el disco duro danado y la dejaron como nueva. Excelentes tecnicos y precios honestos."
        </p>
        <p class="font-semibold text-slate-900">Carlos Rodriguez</p>
      </div>

      <div class="rounded-lg border-l-4 border-blue-500 bg-white p-8 shadow-md">
        <div class="mb-4 flex gap-1">
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
          <span class="text-yellow-400">★</span>
        </div>
        <p class="mb-4 text-slate-700">
          "Llevan anos reparando las computadoras de nuestro negocio. Confiables, rapidos y honestos."
        </p>
        <p class="font-semibold text-slate-900">Jorge Sanchez</p>
      </div>
    </div>
  </div>
</section>
