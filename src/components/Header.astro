---
// Sticky header with logo, search bar, and navigation
---

<header class="sticky top-0 z-50 border-b border-medium-gray bg-white/95 backdrop-blur-sm">
  <div class="container-custom">
    <div class="flex h-16 items-center justify-between gap-4 md:h-20">
      <a href="/" class="flex flex-shrink-0 items-center">
        <img src="/header.png" alt="CDSE" class="h-12 w-auto object-contain md:h-14">
      </a>

      <div class="mx-4 hidden max-w-md flex-1 md:flex lg:mx-6">
        <div class="relative w-full">
          <input
            type="text"
            placeholder="Buscar servicios, productos..."
            class="w-full rounded-lg border border-medium-gray bg-light-gray px-4 py-2.5 pl-11 text-sm transition-all focus:border-transparent focus:outline-none focus:ring-2 focus:ring-electric-blue"
          />
          <svg class="absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <nav class="hidden items-center gap-6 lg:flex">
          <a href="/solar" class="text-sm font-semibold text-amber-600 transition-colors hover:text-amber-700">Paneles solares</a>
          <a href="/catalogo" class="text-sm font-semibold text-electric-blue transition-colors hover:text-blue-700">Catalogo</a>
          <a href="#servicios" class="text-sm font-medium text-text-secondary transition-colors hover:text-electric-blue">Servicios</a>
          <a href="/ubicacion" class="text-sm font-medium text-text-secondary transition-colors hover:text-electric-blue">Ubicacion</a>
          <a href="#nosotros" class="text-sm font-medium text-text-secondary transition-colors hover:text-electric-blue">Nosotros</a>
        </nav>

        <button
          class="rounded-lg p-2 transition-colors hover:bg-light-gray lg:hidden"
          aria-label="Abrir menu"
          id="mobile-menu-btn"
        >
          <svg class="h-6 w-6 text-text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div class="px-1 pb-4 md:hidden">
      <div class="scrollbar-hide flex items-center gap-2 overflow-x-auto pb-3">
        <a href="/solar" class="shrink-0 rounded-full bg-amber-500 px-4 py-2 text-xs font-semibold text-slate-900">
          Paneles solares
        </a>
        <a href="/catalogo" class="shrink-0 rounded-full bg-electric-blue px-4 py-2 text-xs font-semibold text-white">
          Catalogo Switch
        </a>
        <a href="#servicios" class="shrink-0 rounded-full border border-medium-gray bg-white px-4 py-2 text-xs font-medium text-text-secondary">
          Servicios
        </a>
        <a href="/ubicacion" class="shrink-0 rounded-full border border-medium-gray bg-white px-4 py-2 text-xs font-medium text-text-secondary">
          Ubicacion
        </a>
      </div>

      <div class="relative">
        <input
          type="text"
          placeholder="Buscar servicios, productos..."
          class="w-full rounded-lg border border-medium-gray bg-light-gray px-4 py-2.5 pl-11 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-electric-blue"
        />
        <svg class="absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </div>
</header>
