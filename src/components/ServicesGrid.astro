---
// Services Grid Component - Astro (zero-JS)

interface Service {
  title: string;
  description: string;
  image: string;
}

const services: Service[] = [
  {
    title: 'Reparacion de Celulares',
    description: 'Especialistas en microsoldadura de precision, reemplazo de pantallas, baterias y restauracion por danos severos.',
    image: '/services1.png',
  },
  {
    title: 'Servicio de Computo Avanzado',
    description: 'Diagnostico a nivel componente de placa madre, actualizacion de hardware, reballing y optimizacion de rendimiento.',
    image: '/services2.png',
  },
  {
    title: 'Reparacion de Consolas',
    description: 'Mantenimiento profundo para PS5, Xbox y Nintendo Switch. Solucion definitiva de drift de joystick y sobrecalentamiento.',
    image: '/services3.png',
  },
];
---

<section id="servicios" class="bg-[#F5F5F7] px-6 py-24 md:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 text-center md:mb-20">
      <h2 class="text-4xl font-bold tracking-tight text-[#1d1d1f] md:text-5xl">
        Nuestros Servicios
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-xl text-[#86868b]">
        Soluciones de ingenieria de precision para tus dispositivos
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {services.map((service) => (
        <div class="group overflow-hidden rounded-[32px] bg-white shadow-sm transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={service.image}
              alt={service.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-8 pb-10">
            <h3 class="mt-2 text-2xl font-semibold text-[#1d1d1f]">
              {service.title}
            </h3>
            <p class="mt-3 leading-relaxed text-[#86868b]">
              {service.description}
            </p>
            <a
              href="#"
              class="mt-6 inline-block font-medium text-[#0066cc] hover:underline"
            >
              Mas informacion →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
