---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import inventory from '../../data/inventory.json';

const whatsappNumber = '526681774845';
const gamesOnly = inventory.filter((game) => !game.isPromo);

export function getStaticPaths() {
  return inventory.filter((game) => !game.isPromo).map((game, index) => ({
    params: { id: String(index) },
    props: { game, index },
  }));
}

const { game, index } = Astro.props;
const prevId = index > 0 ? String(index - 1) : null;
const nextId = index < gamesOnly.length - 1 ? String(index + 1) : null;

const hasScreenshots = game.screenshots && game.screenshots.length > 0;
const pageTitle = `${game.name} | Catalogo Nintendo Switch | CDSE`;
const pageDesc = game.summary
  ? game.summary.substring(0, 160).replace(/\n/g, ' ') + (game.summary.length > 160 ? '...' : '')
  : `Descubre ${game.name} en el catalogo digital de CDSE para Nintendo Switch.`;
const ogImage = game.cover || 'https://cdse.com.mx/og-landpage.png';
const ogUrl = `https://cdse.com.mx/juego/${index}`;
const whatsappMessage = `Hola CDSE, quiero el juego ${game.name} para mi Nintendo Switch.`;
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<CatalogLayout
  title={pageTitle}
  description={pageDesc}
  ogImage={ogImage}
  ogUrl={ogUrl}
  canonical={ogUrl}
>
  <main class="min-h-screen">
    <header class="border-b border-white/10 bg-[#050505]/80 backdrop-blur-xl">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/catalogo" class="flex shrink-0 items-center gap-2 text-white/60 transition-colors hover:text-[#12B5C9]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
          <span class="text-sm font-medium">Catalogo</span>
        </a>
        <span class="truncate font-mono text-[10px] uppercase tracking-wider text-white/40">Ficha tecnica</span>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-4 pb-8 pt-6 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[280px_1fr]">
        <div class="mx-auto w-full max-w-[240px] lg:mx-0 lg:max-w-none">
          <div class="group relative">
            <div class="absolute -inset-1 rounded-xl bg-[#12B5C9]/10 opacity-60 blur-lg transition-opacity group-hover:opacity-80"></div>
            <div class="absolute -inset-[1px] rounded-xl ring-1 ring-[#12B5C9]/20"></div>
            <div class="relative aspect-[3/4] overflow-hidden rounded-xl border border-white/10 bg-white/[0.03]">
              {game.cover ? (
                <img
                  src={game.cover}
                  alt={`Portada de ${game.name}`}
                  loading="eager"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-white/20">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </div>
              )}
            </div>
          </div>
        </div>

        <div class="flex min-w-0 flex-col gap-4">
          <div>
            <h1 class="text-xl font-bold leading-snug tracking-tight text-white sm:text-2xl lg:text-[1.65rem]">
              {game.name}
            </h1>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {game.genres.map((genre) => (
              <span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-medium text-white/60">
                {genre}
              </span>
            ))}
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-[#12B5C9] to-[#0ea5a5] px-4 py-2 text-xs font-bold uppercase tracking-wide text-[#050505] transition-all duration-200 hover:scale-[1.02] hover:shadow-[0_0_16px_rgba(18,181,201,0.35)] active:scale-[0.98]"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Pedir por WhatsApp
            </a>
            <a
              href="/catalogo"
              class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-white transition-all duration-200 hover:border-white/20 hover:bg-white/10"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
              </svg>
              Ver catalogo
            </a>
          </div>

          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
            <h2 class="mb-2 text-xs font-bold uppercase tracking-wider text-white/90">Resumen tecnico</h2>
            <p class="text-xs leading-relaxed text-white/50">
              {game.summary || 'Sin resumen disponible.'}
            </p>
          </div>
        </div>
      </div>

      {hasScreenshots && (
        <div class="mt-6">
          <h2 class="mb-2 text-xs font-bold uppercase tracking-wider text-white/40">Galeria</h2>
          <div class="flex gap-2 overflow-x-auto pb-2">
            {game.screenshots.map((image, screenshotIndex) => (
              <div class="aspect-video w-40 shrink-0 overflow-hidden rounded-lg border border-white/10 bg-white/[0.03] sm:w-48">
                <img
                  src={image}
                  alt={`${game.name} captura ${screenshotIndex + 1}`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-6 flex items-center justify-between gap-3 border-t border-white/10 pt-4">
        {prevId ? (
          <a href={`/juego/${prevId}`} class="group flex items-center gap-2 text-white/40 transition-colors hover:text-[#12B5C9]">
            <svg class="h-4 w-4 shrink-0 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            <div class="min-w-0">
              <span class="block font-mono text-[9px] uppercase tracking-wider">Anterior</span>
              <span class="block max-w-[120px] truncate text-xs font-medium sm:max-w-[180px]">{gamesOnly[Number(prevId)].name}</span>
            </div>
          </a>
        ) : (
          <div></div>
        )}

        {nextId ? (
          <a href={`/juego/${nextId}`} class="group flex items-center gap-2 text-white/40 transition-colors hover:text-[#12B5C9]">
            <div class="min-w-0 text-right">
              <span class="block font-mono text-[9px] uppercase tracking-wider">Siguiente</span>
              <span class="block max-w-[120px] truncate text-xs font-medium sm:max-w-[180px]">{gamesOnly[Number(nextId)].name}</span>
            </div>
            <svg class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        ) : (
          <div></div>
        )}
      </div>
    </div>
  </main>
</CatalogLayout>
