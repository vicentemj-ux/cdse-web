---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CatalogPromo from '../components/CatalogPromo.astro';
import ViralTechShowcase from '../components/ViralTechShowcase.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TrustSignals from '../components/TrustSignals.astro';
---

<BaseLayout
  title="CDSE - Reparacion de Electronicos en Los Mochis"
  description="Reparacion profesional de celulares, computadoras y consolas de videojuegos. Mas de 16 anos de experiencia y confianza."
  ogTitle="CDSE - Reparacion de Celulares, Computadoras y Consolas en Los Mochis"
  ogDescription="Mas de 16 anos reparando celulares, computadoras y consolas de videojuegos en Los Mochis, Sinaloa. Servicio rapido y profesional. Contactanos por WhatsApp."
  ogImage="https://cdse.com.mx/og-landpage.png"
  ogImageAlt="CDSE - Centro de Soluciones Electronicas en Los Mochis, Sinaloa. Reparacion de celulares, computadoras y consolas."
  ogUrl="https://cdse.com.mx"
>
  <Hero />
  <CatalogPromo />
  <ViralTechShowcase />
  <ServicesGrid />
  <TrustSignals />
</BaseLayout>
