# Cliente público de Supabase. La anon key es segura en navegador cuando RLS
# permanece habilitado; nunca exponga SUPABASE_SERVICE_ROLE_KEY en Vercel.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Endpoint público de la Edge Function para leads de la landing.
PUBLIC_SOLAR_QUOTE_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/create-solar-quote

# Cloudflare Turnstile es opcional. Si se habilita en el frontend,
# configure tambien TURNSTILE_SECRET_KEY como secreto de la Edge Function.
PUBLIC_TURNSTILE_SITE_KEY=
