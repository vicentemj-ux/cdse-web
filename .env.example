# Endpoint publico de la Edge Function desplegada.
# Ejemplo: https://<project-ref>.supabase.co/functions/v1/create-solar-quote
PUBLIC_SOLAR_QUOTE_ENDPOINT=

# Cloudflare Turnstile es opcional. Si se habilita en el frontend,
# configure tambien TURNSTILE_SECRET_KEY como secreto de la Edge Function.
PUBLIC_TURNSTILE_SITE_KEY=
